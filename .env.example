# ============================================================
# Lisa — Miljøvariabler
# ============================================================
# Kopiér denne fil til .env og udfyld værdierne.
# Variabler markeret PÅKRÆVET skal udfyldes, før Lisa starter.
# Variabler markeret VALGFRI har standardværdier og kan efterlades tomme.
#
#   cp .env.example .env
#
# Commit ALDRIG .env til versionsstyring — den indeholder hemmeligheder.
# ============================================================


# ------------------------------------------------------------
# TWILIO — SMS-gateway-legitimationsoplysninger
# Find alle tre værdier på: https://console.twilio.com
# ------------------------------------------------------------

# PÅKRÆVET — Twilio Account SID (starter med "AC")
TWILIO_ACCOUNT_SID=

# PÅKRÆVET — Twilio Auth Token (vises på dit Twilio-konsol-dashboard)
TWILIO_AUTH_TOKEN=

# PÅKRÆVET — Det Twilio-telefonnummer Lisa bruger til at sende/modtage SMS
# Format: E.164 — eks. +4512345678
TWILIO_PHONE_NUMBER=


# ------------------------------------------------------------
# ANTHROPIC — AI-model-legitimationsoplysninger
# Hent din API-nøgle på: https://console.anthropic.com
# ------------------------------------------------------------

# PÅKRÆVET — Anthropic API-nøgle (starter med "sk-ant-")
ANTHROPIC_API_KEY=


# ------------------------------------------------------------
# EJER — Dit personlige telefonnummer
# Lisa sender eskaleringer, opsummeringer og advarsler til dette nummer.
# ------------------------------------------------------------

# PÅKRÆVET — Ejerens personlige mobilnummer i E.164-format
# Eks. +4512345678
OWNER_PHONE=


# ============================================================
# KALENDER — vælg ÉN backend nedenfor
# ============================================================
# Vælg din kalender-backend i config.yaml:
#   calendar_backend: google    # Google Calendar
#   calendar_backend: caldav    # iCloud / Apple Calendar (eller anden CalDAV)
# Standard er "google" hvis feltet udelades (bagudkompatibelt).
# ============================================================


# ------------------------------------------------------------
# GOOGLE CALENDAR — bruges når calendar_backend == "google"
# Sådan henter du dem:
#   1. Gå til https://console.cloud.google.com
#   2. Opret en tjenestekonto og download JSON-nøglefilen
#   3. Del din Google Calendar med tjenestekonto-e-mailadressen
#   4. Indsæt hele JSON-indholdet her som én enkelt linje
#      (brug: python -c "import json,sys; print(json.dumps(json.load(open('key.json'))))")
# ALTERNATIV: OAuth2 refresh token (sæt GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# GOOGLE_REFRESH_TOKEN — én af de to metoder skal bruges).
# ------------------------------------------------------------

# Google-tjenestekonto JSON (enkelt-linje-streng) — eller brug OAuth2-vars nedenfor
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


# ------------------------------------------------------------
# CALDAV — bruges når calendar_backend == "caldav"
# Til iCloud: kræver Apple ID + app-specifikt password
# (genereres på appleid.apple.com → Sign-In and Security → App-Specific Passwords).
# Se docs/CALDAV_SETUP.md for trinvis vejledning.
# ------------------------------------------------------------

# CalDAV-server-URL. Standard er iCloud; lad stå tom hvis du bruger Google.
CALDAV_URL=https://caldav.icloud.com/

# Apple ID-e-mail (eller CalDAV-brugernavn for andre servere)
CALDAV_USERNAME=

# App-specifikt password (IKKE dit normale Apple ID-password)
CALDAV_PASSWORD=


# ------------------------------------------------------------
# DATABASE — SQLite-databaseplacering
# VALGFRI — standard er sqlite:///lisa.db (fil i projektets rod)
# Skift kun hvis du vil gemme databasen et andet sted.
# ------------------------------------------------------------

DATABASE_URL=sqlite:///lisa.db


# ------------------------------------------------------------
# ICAL — Ældre Apple Calendar-feed (valgfri, skrivebeskyttet)
# VALGFRI — lad stå tomt, hvis du kun bruger Google Calendar
# Beholdt til fallback-kompatibilitet; Google Calendar foretrækkes.
# Format: https://p12-caldav.icloud.com/... (fra iCloud-indstillinger)
# ------------------------------------------------------------

ICAL_URL=


# ------------------------------------------------------------
# SENTRY — fejlovervågning (error tracking)
# VALGFRI — lad stå tom for at slå Sentry fra (lokal/dev/test).
# Når DSN er sat, rapporteres ubehandlede undtagelser i webhooken OG
# fejl i baggrundsjob (poller/påmindelser/opsummeringer) i realtid.
# Opret et gratis projekt på https://sentry.io → kopiér DSN'en hertil.
# ------------------------------------------------------------

# Sentry DSN (eks. https://<key>@o0.ingest.sentry.io/<project>)
SENTRY_DSN=
# VALGFRI — miljønavn vist i Sentry (standard: "production")
SENTRY_ENVIRONMENT=
# VALGFRI — andel af requests med performance-tracing (0.0–1.0, standard 0.0)
SENTRY_TRACES_SAMPLE_RATE=

# ------------------------------------------------------------
# SKOLEKONFIGURATION — hvilken skole denne deploy betjener
# ------------------------------------------------------------

# VALGFRI — sti til skolens config-fil. Standard: config.yaml i repo-roden.
# Én deploy betjener ÉN skole. Skole nummer to er en ny Railway-service med sin
# egen CONFIG_PATH — ikke en delt deploy.
# En relativ sti slås op fra repo-roden (IKKE processens arbejdsmappe, som er en
# anden på Railway end lokalt). En absolut sti bruges som den er.
# ⚠️ Læses ved import-tid: ændringen slår først igennem ved procesgenstart.
# CONFIG_PATH=config.oemer.yaml

# VALGFRI — daglig fejl-kun helbredsping (07:30, kun SMS hvis noget er galt).
# Standard "1" (til). Sæt til "0" MENS ingen pilot kører: en død kalender-
# credential får den ellers til at fyre hver eneste dag om noget ingen har tænkt
# sig at fixe endnu — og så holder man op med at læse kanalen.
# ⚠️ Sæt den tilbage til "1", FØR en pilot går live.
HEALTH_ALERT_ENABLED=1

# ------------------------------------------------------------
# KUN LOKAL UDVIKLING — Twilio-signaturtjek
# MÅ ALDRIG sættes i produktion.
# ------------------------------------------------------------

# VALGFRI — sæt til præcis "1" for at springe Twilios signaturvalidering over,
# så du kan poste til /sms fra curl eller en test uden en gyldig signatur.
# Enhver anden værdi ("0", "true", "yes", tom) slår IKKE bypasset til.
# Er den sat, accepterer webhooken uautentificeret input: alle kan indsætte
# "SMS" i pipelinen (LLM-forbrug, opdigtede bookinger, spam til ejeren).
# Bypasset logger en WARNING hver gang det rammer — ser du den linje i en
# produktionslog, er signaturtjekket slået fra.
# Lad den stå udkommenteret her, så den aldrig følger med et miljø ved et uheld.
# LISA_SKIP_TWILIO_SIGNATURE=1
